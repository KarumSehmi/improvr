rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only you can read or write your own data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Buddy pages: anyone with the exact secret link can read that one page (no listing).
    // Only its owner can create, change or delete it.
    match /buddy/{token} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
